# Vercel の Environment Variables(ローカルでは .env.local)に設定する。
# このファイルには実際の値を書かないこと。

# Vercel Cron の認証用。16文字以上。生成例: openssl rand -hex 32
CRON_SECRET=

# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# LINE Developers > QUONTERRA ACADEMY チャネル > Messaging API > チャネルアクセストークン(長期)
LINE_CHANNEL_ACCESS_TOKEN_ACADEMY=

# 「詳しく見る」ボタンのリンク先(https のみ)
MARKET_ROUTINE_URL=https://market-routine.vercel.app/

# 株価指数(日経平均 / NYダウ / S&P500 / NASDAQ)を配信する場合は true。
# 各指数の配信許諾を取得してから有効にすること。
ENABLE_LICENSED_INDICES=false
